# MongoDB Atlas connection string (create a free M0 cluster at https://cloud.mongodb.com)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/verenza?retryWrites=true&w=majority

# Random secret used to sign admin session JWTs (generate e.g. `openssl rand -hex 32`)
JWT_SECRET=

# Resend (https://resend.com) API key for sending inquiry notification emails
RESEND_API_KEY=

# Sender address for outgoing email. Resend's shared "onboarding@resend.dev" works
# without domain verification but can only send to the account owner's email —
# verify your own domain in the Resend dashboard before going to production.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Where new contact-inquiry notifications are sent
CONTACT_NOTIFICATION_EMAIL=

# Used by scripts/seed-admin.mjs to create the first admin account (not read at runtime)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
